# Contact form delivery — configure ONE of the following.
# With neither set: development writes to .data/contact-submissions.jsonl,
# production answers 503 "not configured" (messages are never silently dropped).

# Option A: email via Resend (https://resend.com)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Must be a sender on a domain verified in Resend.
CONTACT_FROM_EMAIL=

# Option B: POST each submission as JSON to a webhook (Slack, Zapier, Make, n8n, your API…)
CONTACT_WEBHOOK_URL=
